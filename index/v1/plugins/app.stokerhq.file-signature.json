        "tag": "v1.0.2"
      },
      "source": {
        "repository": "https://github.com/StokerHQ/file-signature-plugin",
        "commit": "dbfc9534778aa6134cf028898c6e10d4e744aee7"
      },
      "signature": {
        "publisher": "stokerhq",
        "algorithm": "ecdsa-p256-sha256",
        "value": "X4XXdDAIuth3TVC9fAOVm1haEQHIfirK1t7v2ERVVQLSsou7qe+dSJi1NWVd8vwfSJWCqZmEGn9tuExUahW5Hg=="
      },
      "abi": 1,
      "hosts": [
        "steamworks",
        "ubisoft",
        "galaxy"
      ],
      "manifestSha256": "dac9e5b82a0316aa7172fa923dc6ac8eb402beb8ebaef8bda846b81532024571",
      "config": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "process": {
            "type": "string",
            "title": "Game executable",
            "description": "Only act in this executable. Omit to act in every process. File name only, ASCII case-insensitive.",
            "minLength": 1,
            "maxLength": 259,
            "pattern": "^(?!\\.{1,2}$)[^\\\\/:]+$"
          },
          "match": {
            "type": "string",
            "title": "File the game checks",
            "description": "Exact final filename to redirect, ASCII case-insensitive. Directories and filename suffixes do not match.",
            "minLength": 1,
            "maxLength": 259,
            "pattern": "^(?!\\.{1,2}$)[^\\\\/:]+$"
          },
          "replace": {
            "type": "string",
            "title": "File to query instead",
            "description": "Filename in the same directory. CryptQueryObject queries this file and preserves the original output parameters and result.",
            "minLength": 1,
            "maxLength": 259,
            "pattern": "^(?!\\.{1,2}$)[^\\\\/:]+$"
          },
          "trustPolicy": {
            "type": "string",
            "title": "WinVerifyTrust policy",
            "default": "forward",
            "enum": [
              "forward",
              "accept-matched",
              "accept-all"
            ],
            "description": "forward preserves verification. accept-matched accepts file checks for the configured filename. accept-all returns success for every WinVerifyTrust call in the selected process."
          },
          "logging": {
            "type": "string",
            "title": "Call logging",
            "default": "quiet",
            "enum": [
              "quiet",
              "changes"
            ],
            "description": "changes logs redirected file queries and accepted trust checks. Initialization is always logged."
          }
        },
        "required": [
          "match",
          "replace"
        ]
      },
