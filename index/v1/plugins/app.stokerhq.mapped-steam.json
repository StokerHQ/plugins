            "maxLength": 259,
            "pattern": "^(?!\\.{1,2}$)[^\\\\/:]+$"
          },
          "remoteStorageVersion": {
            "type": "string",
            "title": "Unversioned RemoteStorage interface",
            "description": "Override the layout returned by SteamRemoteStorage. Omit to keep the bootstrap's legacy layout.",
